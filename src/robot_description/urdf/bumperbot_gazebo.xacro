<?xml version="1.0"?>
<robot name="bumperbot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ============================================================= -->
  <!-- Friction - Gazebo Fortress utilise le moteur physique DART.   -->
  <!-- Seuls mu1/mu2 sont pris en compte. Les balises kp, kd,        -->
  <!-- minDepth, maxVel, fdir1 sont specifiques a ODE (Gazebo        -->
  <!-- Classic) et sont IGNOREES par DART : je les ai retirees pour  -->
  <!-- eviter toute confusion.                                       -->
  <!-- ============================================================= -->

  <!-- Roues motrices : forte adherence -->
  <gazebo reference="wheel_left_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="wheel_right_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <!-- Roulettes : faible friction pour glisser librement -->
  <gazebo reference="caster_front_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

  <gazebo reference="caster_rear_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

</robot>